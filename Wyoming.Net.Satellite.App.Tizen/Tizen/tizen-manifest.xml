<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns="http://tizen.org/ns/packages" api-version="8.0" package="com.guilhermepohlmann.wyoming.net" version="1.0.0">
  <profile name="tv" />
  <ui-application appid="com.guilhermepohlmann.wyoming.net"
					exec="Wyoming.Net.Satellite.App.Tizen.dll"
					type="dotnet-nui"
					multiple="false"
					taskmanage="true"
					nodisplay="false"
					launch_mode="single"
          api-version="12">
    <label>Wyoming.Net</label>
    <icon>app_icon_black.png</icon>
    <metadata key="http://tizen.org/metadata/prefer_dotnet_aot" value="true" />
  </ui-application>

  <service-application appid="com.guilhermepohlmann.wyoming.net.service" 
                       exec="Wyoming.Net.Satellite.App.Tizen.dll" 
                       type="dotnet"
                       nodisplay="true"
                       api-version="12"
                       launch_mode="single">
    <category name="http://tizen.org/category/voice_control_engine"/>
    <!-- <metadata key="http://samsung.com/tv/metadata/use.low_power_mode" value="true"/> -->
    <background-category value="media"/>
    <background-category value="network"/>
    <background-category value="background-network"/>
    <background-category value="iot-communication"/>
  </service-application>

  <service-application appid="com.guilhermepohlmann.wyoming.net.profiler"
                       exec="Wyoming.Net.Satellite.App.Tizen.dll"
                       type="dotnet"
                       nodisplay="true"
                       api-version="12"
                       launch_mode="single">
  </service-application>

      <privileges> 
        <privilege>http://tizen.org/privilege/mediastorage</privilege>  
        <privilege>http://tizen.org/privilege/externalstorage</privilege>
        <privilege>http://tizen.org/privilege/ml.inference</privilege>
        <privilege>http://tizen.org/privilege/recorder</privilege>
        <privilege>http://tizen.org/privilege/audio.output</privilege>
        <privilege>http://tizen.org/privilege/appmanager.launch</privilege>
        <privilege>http://tizen.org/privilege/systemmonitor</privilege>
        <privilege>http://tizen.org/privilege/display</privilege>
        <privilege>http://tizen.org/privilege/power</privilege>
     </privileges>
    <feature name="http://tizen.org/feature/machine_learning"/>
    <feature name="http://tizen.org/feature/machine_learning.inference"/>
    <feature name="http://tizen.org/feature/microphone"/>
    <feature name="http://tizen.org/feature/tv.display"/>
    <feature name="http://tizen.org/feature/tv.display.state"/>
    <feature name="http://tizen.org/feature/display.state" />
</manifest>
